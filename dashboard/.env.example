# Single-user login
DASHBOARD_USERNAME=chathushka
DASHBOARD_PASSWORD=change-me

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Same Neon Postgres DB the orchestrator/trust_layer writes to. This is what
# the Overview, Approvals, and Activity pages read.
# Copy this file to .env.local (gitignored) and put the real value there —
# never commit a real connection string.
LOG_DATABASE_URL=postgresql://<user>:<password>@<project>.neon.tech/<database>?sslmode=require

# Same MongoDB the job-tracker-mcp server uses. The Jobs page reads
# job_matches (what the daily n8n search found) and job_applications (what
# you've actually applied to) from here. Use the identical connection string
# as mcp-servers/job-tracker-mcp/.env so both read the same data.
# Leave blank and the Jobs page explains what's missing instead of erroring.
MONGO_URL=
MONGO_DB=second_brain

# Must be the SAME path as RESUME_DIR in mcp-servers/job-tracker-mcp/.env —
# this dashboard's Resumes page writes/deletes files here, and
# select_best_resume reads from the same directory. Locally that means the
# same value in both .env files; on the VPS, both processes share this
# absolute path on disk.
RESUME_DIR=

# Mirrors AUTO_EXECUTE_CONFIDENCE_THRESHOLD from the orchestrator's config.
# The dashboard only *displays* this — it marks the threshold on every
# confidence meter so you can see why an action stopped for approval. The
# orchestrator's own value is what actually gates execution; keep them in sync.
NEXT_PUBLIC_AUTO_EXECUTE_CONFIDENCE_THRESHOLD=0.75
