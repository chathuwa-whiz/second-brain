# Single-user login
DASHBOARD_USERNAME=chathushka
DASHBOARD_PASSWORD=change-me

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Same Neon Postgres DB the orchestrator/trust_layer writes to.
# Copy this file to .env.local (gitignored) and put the real value there —
# never commit a real connection string.
LOG_DATABASE_URL=postgresql://<user>:<password>@<project>.neon.tech/<database>?sslmode=require
