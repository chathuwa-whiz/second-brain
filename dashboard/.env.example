# NextAuth Secret & Base URL
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (For "Continue with Google" sign-in)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (or your production domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Dispatcher & Verification (SMTP via Gmail, SendGrid, Resend, Amazon SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Second Brain <no-reply@secondbrain.app>

# ============================================================================
# Oracle Autonomous AI Database (23ai Serverless)
# Primary database for Users, Auth, Actions, Approvals, Activity, & Settings.
# ============================================================================
ORACLE_USER=ADMIN
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECT_STRING=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.ap-singapore-1.oraclecloud.com))(connect_data=(service_name=g9cfbd628b0ef7a_secondbrain_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# PostgreSQL (Optional alternative to Oracle DB):
# DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/second_brain?sslmode=require

# ============================================================================
# MongoDB (For module data: job matches, applications, tasks)
# ============================================================================
MONGO_URL=
MONGO_DB=second_brain

# Resume directory
RESUME_DIR=/opt/second-brain/resumes

# AI Agent Configuration
NEXT_PUBLIC_AUTO_EXECUTE_CONFIDENCE_THRESHOLD=0.70
