# NextAuth Secret & Base URL
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (For "Continue with Google" sign-in)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (or your production domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Dispatcher (SMTP via Gmail, SendGrid, Resend, Amazon SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Second Brain <no-reply@secondbrain.app>

# ============================================================================
# Cloudflare R2 Object Storage (10 GB Free Tier S3-compatible storage)
# Used for storing multi-tenant user resumes (Max 5 resumes per user)
# ============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=second-brain-resumes
# R2_PUBLIC_DOMAIN=https://your-custom-r2-domain.com

# ============================================================================
# Lemon Squeezy Billing (Merchant of Record — Google Pay, Apple Pay, PayPal & Cards)
# Plans: Monthly ($2.99 / mo) & Annual ($19.00 / yr) after 7-day free trial
# Obtain from Lemon Squeezy Dashboard > Settings > API Keys & Webhooks
# ============================================================================
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_YEARLY_VARIANT_ID=

# ============================================================================
# MongoDB (Unified NoSQL Database)
# Single database for Auth, Users, API Keys, Action Logs, Matches & Settings
# ============================================================================
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=second_brain

# Resume directory (Local filesystem fallback if R2 is not configured)
RESUME_DIR=/opt/second-brain/resumes

# AI Agent Configuration
NEXT_PUBLIC_AUTO_EXECUTE_CONFIDENCE_THRESHOLD=0.70
