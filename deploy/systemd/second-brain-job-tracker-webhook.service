# job-tracker-mcp's webhook — n8n's Job Search Matcher v3 posts scored job
# matches here (see mcp-servers/job-tracker-mcp/README.md for the endpoint
# it exposes).
#
# Install:
#   sudo cp second-brain-job-tracker-webhook.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now second-brain-job-tracker-webhook
[Unit]
Description=second-brain job-tracker-mcp webhook
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/second-brain/mcp-servers/job-tracker-mcp
EnvironmentFile=/opt/second-brain/mcp-servers/job-tracker-mcp/.env
ExecStart=/opt/second-brain/mcp-servers/job-tracker-mcp/.venv/bin/uvicorn webhook_server:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5
MemoryMax=160M
User=www-data

[Install]
WantedBy=multi-user.target
