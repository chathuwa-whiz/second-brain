# LLM gateway (your self-hosted 9router, same one your n8n workflows use)
LLM_BASE_URL=http://62.171.163.6:20128/v1
LLM_MODEL=GeminiALL
LLM_API_KEY=not-needed

# task-mcp and job-tracker-mcp, each launched as local subprocesses.
# Defaults below already point at the right relative paths — override only
# if you've moved things or deployed a server standalone.
TASK_MCP_COMMAND=python
TASK_MCP_ARGS=../mcp-servers/task-mcp/server.py
JOB_TRACKER_MCP_COMMAND=python
JOB_TRACKER_MCP_ARGS=../mcp-servers/job-tracker-mcp/server.py

# Below this, decisions are logged as "pending" instead of auto-executed
AUTO_EXECUTE_CONFIDENCE_THRESHOLD=0.75

# trust_layer/logger.py reads this — your Neon connection string.
# Get it from the Neon dashboard -> Connection Details -> "Pooled connection".
# Neon connection strings already include ?sslmode=require, which psycopg2
# picks up automatically from the URL.
# Copy this file to .env (gitignored) and put the real value there — never
# commit a real connection string.
LOG_DATABASE_URL=postgresql://<user>:<password>@<project>.neon.tech/<database>?sslmode=require

# task-mcp/server.py reads this (only needed if you run it standalone too) —
# your MongoDB Atlas connection string (mongodb+srv://... — TLS is implied).
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=second_brain

# --- webhook_server.py ---------------------------------------------------
# Shared secret required on every request to the orchestrator's webhook
# (POST /webhook/request). This endpoint can trigger real, auto-executed
# actions -- treat this secret at least as seriously as a database password.
# Generate with: openssl rand -hex 32
ORCHESTRATOR_WEBHOOK_SECRET=
