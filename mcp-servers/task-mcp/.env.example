# task-mcp only needs MongoDB — your MongoDB Atlas connection string
# (mongodb+srv://... — TLS is implied by the srv scheme, no extra config needed).
#
# Copy this file to .env (gitignored) and put the real value there — never
# hardcode it in server.py or commit a real connection string.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=second_brain
