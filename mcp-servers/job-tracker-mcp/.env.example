# job-tracker-mcp needs MongoDB (application data) and the LLM gateway
# (for match_resume_to_posting / draft_cover_letter).
#
# Copy this file to .env (gitignored) and put real values there — never
# hardcode a real connection string or API key in server.py or commit one.

# Can reuse the same Atlas cluster as task-mcp, or a separate one — either
# way it lands in its own "job_applications" collection.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=second_brain

# Your self-hosted 9router gateway, same one your n8n job-search workflow
# and the orchestrator use.
LLM_BASE_URL=http://62.171.163.6:20128/v1
LLM_MODEL=GeminiALL
LLM_API_KEY=not-needed

# Optional — used to sign draft_cover_letter output (e.g. "Chathushka Navod").
# Can also be passed per-call via the candidate_name tool argument, which
# takes priority over this. Leave blank and letters end with "Sincerely,"
# and no name, rather than a guessed/fabricated one.
CANDIDATE_NAME=

# --- select_best_resume storage backend -------------------------------
# Primary/recommended: local (or VPS) directory. Point this at wherever
# the second-brain webapp's resume upload handler writes files — no
# external API, no credentials. Just needs job-tracker-mcp and the webapp
# to agree on this one path. Example (Windows dev): D:\second-brain\resumes
# Example (VPS later): /data/second-brain/resumes
RESUME_DIR=

# Optional secondary backend: Google Drive. Only used if RESUME_DIR above
# is not set. Requires a one-time Google Cloud Console setup — see
# drive_resumes.py's docstring. Skip this section entirely if you're using
# RESUME_DIR.
GOOGLE_SERVICE_ACCOUNT_FILE=
RESUME_DRIVE_FOLDER_ID=
